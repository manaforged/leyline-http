{
  "name": "@manaforged/leyline",
  "version": "1.0.0",
  "description": "Node.js bindings for Leyline — browser-fidelity TLS/HTTP fingerprint sessions",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/manaforged/leyline-http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manaforged/leyline-http.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "wrappers/node/leyline.js",
  "types": "wrappers/node/leyline.d.ts",
  "exports": {
    ".": {
      "types": "./wrappers/node/leyline.d.ts",
      "default": "./wrappers/node/leyline.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "name": "leyline",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd crates/leyline-node wrappers/node",
    "build:debug": "napi build --platform --cargo-cwd crates/leyline-node wrappers/node",
    "artifacts": "napi artifacts --dir artifacts --dist npm",
    "test": "node wrappers/node/test/offline.js && node wrappers/node/test/smoke.js"
  },
  "files": [
    "wrappers/node/leyline.js",
    "wrappers/node/leyline.d.ts",
    "wrappers/node/index.js",
    "wrappers/node/index.d.ts",
    "wrappers/node/README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "optionalDependencies": {
    "@manaforged/leyline-darwin-arm64": "1.0.0",
    "@manaforged/leyline-linux-x64-gnu": "1.0.0",
    "@manaforged/leyline-win32-x64-msvc": "1.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
