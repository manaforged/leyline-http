--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3264,6 +3264,27 @@ static bool ext_quic_transport_params_add_serverhello_legacy(SSL_HANDSHAKE *hs,
 static bool ext_delegated_credential_add_clienthello(
     const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
     ssl_client_hello_type_t type) {
+  if (hs->config->delegated_credentials.empty()) {
+    return true;
+  }
+
+  CBB contents, sigalgs_cbb;
+  if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &sigalgs_cbb)) {
+    return false;
+  }
+
+  for (const uint16_t alg : hs->config->delegated_credentials) {
+    if (!CBB_add_u16(&sigalgs_cbb, alg)) {
+      return false;
+    }
+  }
+
+  if (!CBB_flush(out_compressible)) {
+    return false;
+  }
+
   return true;
 }
 
