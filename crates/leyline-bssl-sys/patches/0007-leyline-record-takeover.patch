index 972fc4b..5373c4b 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -3365,6 +3365,38 @@ int SSL_CTX_set_extension_tail(SSL_CTX *ctx, const uint16_t *tail,
   return 1;
 }
 
+int SSL_copy_traffic_secrets(const SSL *ssl, uint8_t *out_read,
+                             uint8_t *out_write, size_t max_len,
+                             size_t *out_len) {
+  Span<const uint8_t> read, write;
+  if (SSL_version(ssl) != TLS1_3_VERSION ||
+      !SSL_get_traffic_secrets(ssl, &read, &write) ||
+      read.size() != write.size() || read.size() > max_len) {
+    return 0;
+  }
+  OPENSSL_memcpy(out_read, read.data(), read.size());
+  OPENSSL_memcpy(out_write, write.data(), write.size());
+  *out_len = read.size();
+  return 1;
+}
+
+int SSL_process_post_handshake(SSL *ssl, const uint8_t *msg, size_t msg_len) {
+  SSLImpl *ssl_impl = FromOpaque(ssl);
+  if (msg_len < 4 || msg[0] != SSL3_MT_NEW_SESSION_TICKET ||
+      ssl_impl->server || SSL_version(ssl) != TLS1_3_VERSION ||
+      ((size_t{msg[1]} << 16) | (size_t{msg[2]} << 8) | msg[3]) !=
+          msg_len - 4) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_UNEXPECTED_MESSAGE);
+    return 0;
+  }
+  SSLMessage message;
+  message.is_v2_hello = false;
+  message.type = msg[0];
+  CBS_init(&message.raw, msg, msg_len);
+  CBS_init(&message.body, msg + 4, msg_len - 4);
+  return tls13_post_handshake(ssl_impl, message);
+}
